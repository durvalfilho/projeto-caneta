---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'A Caneta Mais Tecnológica do Mundo | Precision Series',
	description = 'A Artools Precision Pen redefine o equilíbrio entre peso, fluxo e design. Feita para criadores que exigem perfeição em cada traço.',
} = Astro.props;
---

<!doctype html>
<html class="scroll-smooth" lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1.0" name="viewport" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>

		<!-- View Transitions Client Router -->
		<ClientRouter />

		<!-- Resource Hints & Non-blocking Fonts (Streamlined to 4 essential fonts) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			href="https://fonts.gstatic.com/s/spacegrotesk/v22/V8mDoQDjQSkFtoMM3T6r8E7mPbF4C_k3HqU.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Pinyon+Script&family=Space+Grotesk:wght@500;700&display=swap"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Pinyon+Script&family=Space+Grotesk:wght@500;700&display=swap"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Pinyon+Script&family=Space+Grotesk:wght@500;700&display=swap"
			/>
		</noscript>
	</head>

	<body class="antialiased min-h-screen relative selection:bg-stone-800 selection:text-white flex flex-col">
		<div class="noise-overlay" transition:persist></div>

		<!-- Mantendo o topo do site fixo entre páginas -->
		<Header />

		<main class="flex-1 w-full" transition:animate="fade">
			<slot />
		</main>

		<!-- Footer Component -->
		<Footer />
	</body>
</html>
