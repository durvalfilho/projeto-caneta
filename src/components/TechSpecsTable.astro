---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const specs = [
	{ label: 'MATERIAL', value: 'Alumínio 6061-T6' },
	{ label: 'PESO', value: '14 g' },
	{ label: 'COMPRIMENTO', value: '138 mm' },
	{ label: 'DIÂMETRO', value: '9.2 mm' },
	{ label: 'PONTA', value: '0.3 mm (Tungstênio)' },
	{ label: 'SISTEMA DE FLUXO', value: 'Capilaridade Assistida' },
	{ label: 'TEMPO DE SECAGEM', value: '< 0.2 s' },
	{ label: 'ÂNGULO DE ESCRITA', value: '15° a 90°' },
	{ label: 'TOLERÂNCIA', value: '± 0.005 mm' },
	{ label: 'RUGOSIDADE DO GRIP', value: 'Ra 0.8 µm' },
	{ label: 'RENDIMENTO', value: '2.500 m' },
	{ label: 'MECANISMO', value: 'Silent-Click' },
];
---

<section
	class:list={[
		'relative z-20 bg-black text-white py-20 md:py-28 overflow-hidden border-t border-stone-900 select-none text-left',
		className,
	]}
	id="specs"
>
	<div class="max-w-[1440px] mx-auto px-6 md:px-24">
		<!-- Section Header (Left-aligned, standard typography) -->
		<div class="max-w-2xl mb-16 md:mb-20 text-left reveal-up">
			<div class="inline-flex items-center gap-2 mb-4">
				<span class="w-1.5 h-1.5 bg-stone-400 rounded-full"></span>
				<span class="text-xs font-mono uppercase tracking-[0.2em] text-stone-400">Specifications</span>
			</div>
			<h2
				class="font-display font-medium text-4xl sm:text-5xl md:text-6xl text-white mb-6 tracking-tight"
			>
				Especificações Técnicas
			</h2>
			<p class="text-stone-400 text-sm md:text-base font-light leading-relaxed">
				Projetada com tolerâncias microscópicas e arquitetura mecânica de alta precisão. Um
				instrumento de escrita concebido para eliminar atrito e oferecer resposta tátil imediata.
			</p>
		</div>

		<!-- Minimalist Specs Table (2-Columns, Sharp Edges, Left-aligned) -->
		<div class="max-w-3xl border-t border-stone-900 reveal-up delay-200">
			{
				specs.map((item) => (
					<div class="grid grid-cols-1 sm:grid-cols-12 py-5 border-b border-stone-900 items-baseline gap-2 sm:gap-6 hover:bg-stone-950 transition-colors duration-150">
						<!-- Label -->
						<div class="sm:col-span-5 text-xs font-mono uppercase tracking-[0.18em] font-semibold text-stone-400">
							{item.label}
						</div>
						<!-- Value -->
						<div class="sm:col-span-7 text-sm md:text-base font-sans text-stone-200 font-light">
							{item.value}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
