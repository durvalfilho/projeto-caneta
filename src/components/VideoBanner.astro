---
interface Props {
	class?: string;
	src?: string;
}

const {
	class: className = '',
	src = '/assets/raw_files/video.mp4',
} = Astro.props;
---

<section
	class:list={[
		'relative w-full h-[250px] md:h-[340px] lg:h-[380px] overflow-hidden bg-black z-20 select-none video-banner-section',
		className,
	]}
>
	<video
		loop
		muted
		playsinline
		preload="none"
		class="w-full h-full object-cover lazy-video"
		aria-label="Vídeo demonstrativo da caneta de precisão Artools"
	>
		<source data-src={src} type="video/mp4" />
		<track kind="captions" src="data:text/vtt,WEBVTT" label="Sem áudio" default />
	</video>

	<script is:inline>
		const initLazyVideos = () => {
			const videos = document.querySelectorAll('.lazy-video');
			if (!videos.length) return;

			if ('IntersectionObserver' in window) {
				const observer = new IntersectionObserver(
					(entries, obs) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								const video = entry.target;
								const source = video.querySelector('source');
								if (source && source.dataset.src && !source.src) {
									source.src = source.dataset.src;
									video.load();
									video.play().catch(() => {});
								}
								obs.unobserve(video);
							}
						});
					},
					{ rootMargin: '300px 0px' }
				);
				videos.forEach((v) => observer.observe(v));
			} else {
				videos.forEach((v) => {
					const source = v.querySelector('source');
					if (source && source.dataset.src && !source.src) {
						source.src = source.dataset.src;
						v.load();
						v.play().catch(() => {});
					}
				});
			}
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initLazyVideos);
		} else {
			initLazyVideos();
		}
		document.addEventListener('astro:page-load', initLazyVideos);
	</script>
</section>

