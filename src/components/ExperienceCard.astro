---
interface Props {
	icon: string;
	title: string;
	description: string;
	delay?: string;
	barDelay?: string;
	class?: string;
}

const {
	icon,
	title,
	description,
	delay = 'delay-200',
	barDelay = '',
	class: className = '',
} = Astro.props;
---

<div
	class:list={[
		'flashlight-card h-[400px] border border-stone-300 bg-white p-8 flex flex-col justify-between rounded-sm hover:shadow-2xl hover:-translate-y-1 transition-all duration-500 group reveal-up',
		delay,
		className,
	]}
>
	<div
		class="w-12 h-12 bg-stone-100 rounded-lg flex items-center justify-center text-stone-900 mb-6 group-hover:bg-stone-900 group-hover:text-white transition-colors duration-500"
	>
		<iconify-icon icon={icon} class="text-2xl"></iconify-icon>
	</div>
	<div>
		<h3 class="text-2xl font-display font-medium mb-3">{title}</h3>
		<p class="text-stone-500 text-sm leading-relaxed">
			{description}
		</p>
	</div>
	<div class="h-1 w-full bg-stone-100 mt-8 overflow-hidden">
		<div
			class:list={[
				'h-full bg-stone-900 w-0 group-hover:w-full transition-all duration-700 ease-out',
				barDelay,
			]}
		>
		</div>
	</div>
</div>
