---
import Icon from './Icon.astro';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<!-- FOOTER -->
<footer class:list={["bg-stone-950 text-stone-400 py-12 border-t border-stone-800 relative z-20", className]}>
	<div
		class="max-w-[1440px] mx-auto px-6 md:px-24 flex flex-col md:flex-row justify-between items-center gap-6"
	>
		<div class="flex items-center gap-2">
			<div class="w-6 h-6 bg-stone-800 text-stone-300 flex items-center justify-center rounded-sm">
				<Icon name="solar:pen-new-square-bold-duotone" class="text-sm" />
			</div>
			<span class="font-display font-medium tracking-tight text-sm text-stone-300"
				>ARTOOLS<span class="text-stone-400">.PRO</span></span
			>
		</div>

		<div class="text-xs font-mono uppercase tracking-widest flex gap-6 text-stone-400">
			<a href="#" class="hover:text-stone-200 transition-colors">Privacy</a>
			<a href="#" class="hover:text-stone-200 transition-colors">Terms</a>
			<a href="#" class="hover:text-stone-200 transition-colors">Support</a>
		</div>

		<div class="text-xs text-stone-400">&copy; 2026 Artools Inc. Zurich.</div>
	</div>
</footer>
