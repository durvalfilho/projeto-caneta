---
import Button from './Button.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	id: string;
	title: string;
	badgeLeft?: string;
	badgeRight?: string;
	image: ImageMetadata | string;
	description: string;
	pena?: string;
	material: string;
	recarga?: string;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
}

const {
	id,
	title,
	badgeLeft = 'EDIÇÃO LIMITADA',
	badgeRight = 'EM BREVE',
	image,
	description,
	pena = 'Aço Inox M',
	material = 'Alumínio 6061',
	recarga = 'Rollerball G2',
	loading = 'lazy',
	fetchpriority = 'auto',
} = Astro.props;
---

<div
	class="group relative flex flex-col justify-between bg-white border border-stone-200/90 rounded-none overflow-hidden hover:shadow-xl transition-all duration-500 hover:-translate-y-1 text-left"
	id={`card-${id}`}
>
	<!-- Top Image (Edge-to-Edge Full Width) -->
	<a href="/produto" class="block relative w-full aspect-[4/3] overflow-hidden bg-stone-100 cursor-pointer">
		<Image
			src={image as any}
			alt={title}
			width={750}
			height={750}
			class="w-full h-full object-cover grayscale contrast-105 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out"
			loading={loading}
			fetchpriority={fetchpriority}
			decoding="async"
		/>

		<!-- Top Left Badge (Black) -->
		{badgeLeft && (
			<div class="absolute top-3.5 left-3.5">
				<span class="text-[9px] font-mono uppercase tracking-widest px-2.5 py-1 bg-black/90 text-white font-medium">
					{badgeLeft}
				</span>
			</div>
		)}

		<!-- Top Right Badge (White) -->
		{badgeRight && (
			<div class="absolute top-3.5 right-3.5">
				<span class="text-[9px] font-mono uppercase tracking-widest px-2.5 py-1 bg-white/95 text-stone-800 font-medium">
					{badgeRight}
				</span>
			</div>
		)}
	</a>

	<!-- Card Body -->
	<div class="p-6 flex flex-col justify-between flex-1">
		<div>
			<!-- Title -->
			<a href="/produto" class="block group-hover:text-stone-600 transition-colors">
				<h3 class="font-display text-lg sm:text-xl font-medium text-stone-900 tracking-tight mb-2 text-left">
					{title}
				</h3>
			</a>

			<!-- Description -->
			<p class="text-xs text-stone-500 font-light leading-relaxed mb-6 text-left">
				{description}
			</p>
		</div>

		<!-- Bottom Specs & Button -->
		<div>
			<!-- 3-Column Minimalist Specs -->
			<div class="grid grid-cols-3 gap-2 pt-4 pb-4 border-t border-stone-100 mb-5 text-left">
				<div>
					<span class="block text-[9px] font-mono uppercase tracking-widest text-stone-400 mb-1">PENA</span>
					<span class="text-xs font-sans text-stone-800 font-normal truncate block" title={pena}>{pena}</span>
				</div>
				<div>
					<span class="block text-[9px] font-mono uppercase tracking-widest text-stone-400 mb-1">MATERIAL</span>
					<span class="text-xs font-sans text-stone-800 font-normal truncate block" title={material}>{material}</span>
				</div>
				<div>
					<span class="block text-[9px] font-mono uppercase tracking-widest text-stone-400 mb-1">RECARGA</span>
					<span class="text-xs font-sans text-stone-800 font-normal truncate block" title={recarga}>{recarga}</span>
				</div>
			</div>

			<!-- Avise-me Button -->
			<Button
				variant="primary"
				size="md"
				fullWidth={true}
				icon="solar:bell-linear"
				iconPosition="left"
				class="notify-btn rounded-none py-3 text-xs font-mono uppercase tracking-widest"
				data-product={title}
			>
				<span>AVISE-ME</span>
			</Button>
		</div>
	</div>
</div>
