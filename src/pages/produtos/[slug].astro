---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import { products, type Product } from '../../data/products';

export async function getStaticPaths() {
	const paths = products.map((product) => ({
		params: { slug: product.slug },
		props: { product },
	}));

	// Alias para garantir retrocompatibilidade com slug por título
	paths.push({
		params: { slug: 'titanium-stealth-minimalist' },
		props: { product: products[0] },
	});

	return paths;
}

interface Props {
	product: Product;
}

const { product } = Astro.props;

// Filtrar outros produtos para a seção de relacionados
const relatedProducts = products
	.filter((p) => p.id !== product.id)
	.slice(0, 3);

// Imagens da galeria com fallback
const galleryImages = product.images && product.images.length > 0
	? product.images
	: [{ image: product.image, label: 'Visão Geral' }];

const pageTitle = product.seoTitle || `${product.title} | ArtTools Precision Series`;
const pageDescription = product.seoDescription || product.description;
const pageImage = '/images/og-produto-03mm.jpg';
---

<Layout title={pageTitle} description={pageDescription} image={pageImage}>
	<div class="min-h-screen bg-[#EAEAE5] pt-28 md:pt-36 selection:bg-stone-900 selection:text-white">
		<!-- 1. BREADCRUMBS -->
		<div class="max-w-[1440px] mx-auto px-6 md:px-24 mb-10 text-left">
			<nav class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-stone-500">
				<a href="/" class="hover:text-stone-900 transition-colors">Início</a>
				<span>/</span>
				<a href="/catalogo" class="hover:text-stone-900 transition-colors">Catálogo</a>
				<span>/</span>
				<span class="text-stone-900 font-medium">{product.title}</span>
			</nav>
		</div>

		<!-- 2. PRODUCT HERO SECTION -->
		<section class="max-w-[1440px] mx-auto px-6 md:px-24 pb-16 md:pb-24">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
				<!-- LEFT: MULTI-ANGLE GALLERY -->
				<div class="lg:col-span-7 flex flex-col gap-4">
					<!-- Main Active Image with Zoom Effect -->
					<div
						class="relative aspect-square w-full bg-stone-100 border border-stone-300 rounded-sm overflow-hidden group shadow-lg"
					>
						<Image
							id="main-product-image"
							src={galleryImages[0].image}
							alt={product.title}
							width={800}
							height={800}
							class="w-full h-full object-cover grayscale contrast-105 group-hover:grayscale-0 transition-all duration-700 ease-out scale-100 group-hover:scale-105"
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>

						<!-- Active Label Tag -->
						<div class="absolute bottom-4 left-4 bg-stone-900/80 backdrop-blur-md px-3 py-1.5 rounded-sm text-white text-[10px] font-mono uppercase tracking-widest">
							<span id="active-image-label">{galleryImages[0].label}</span>
						</div>

						<!-- Badge Overlay -->
						<div class="absolute top-4 left-4 flex gap-2">
							{product.badgeLeft && (
								<span class="text-[9px] font-mono uppercase tracking-widest px-2.5 py-1 bg-stone-900 text-white font-medium rounded-sm">
									{product.badgeLeft}
								</span>
							)}
							{product.badgeRight && (
								<span class="text-[9px] font-mono uppercase tracking-widest px-2.5 py-1 bg-white/90 border border-stone-300 text-stone-900 font-medium rounded-sm">
									{product.badgeRight}
								</span>
							)}
						</div>
					</div>

					<!-- Thumbnails Selector -->
					<div class="grid grid-cols-4 gap-3">
						{
							galleryImages.map((item, idx) => (
								<button
									class:list={[
										"thumb-btn relative aspect-square bg-stone-100 border rounded-sm overflow-hidden cursor-pointer transition-all p-1",
										idx === 0 ? "border-stone-900 ring-2 ring-stone-900/10" : "border-stone-300 opacity-60 hover:opacity-100"
									]}
									data-index={idx}
									data-label={item.label}
									data-img-src={typeof item.image === 'string' ? item.image : item.image.src}
									aria-label={`Ver ${item.label}`}
								>
									<Image
										src={item.image}
										alt={`${product.title} - ${item.label}`}
										width={200}
										height={200}
										class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-300"
										loading="lazy"
										decoding="async"
									/>
								</button>
							))
						}
					</div>
				</div>

				<!-- RIGHT: PRODUCT INFO & CTA -->
				<div class="lg:col-span-5 flex flex-col justify-between text-left">
					<div>
						<!-- Pill Badge -->
						<div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-sm bg-stone-200/60 border border-stone-300/80 text-stone-600 text-xs font-mono mb-4">
							<span class="w-1.5 h-1.5 bg-stone-500 rounded-sm"></span>
							<span>{product.series}</span>
						</div>

						<!-- Title -->
						<h1
							class="font-display text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-stone-900 mb-4 leading-[1.1]"
						>
							{product.title}
						</h1>

						<!-- Description -->
						<p class="text-stone-600 text-sm md:text-base font-light leading-relaxed mb-8">
							{product.description}
						</p>

						<!-- Minimalist 2-Column Specs Table -->
						<h2 class="sr-only">Características Técnicas</h2>
						<div class="border-t border-stone-300 mb-8">
							{
								product.specs.map((item) => (
									<div class="grid grid-cols-12 py-3.5 border-b border-stone-300/80 items-baseline gap-4">
										<div class="col-span-5 text-xs font-mono uppercase tracking-[0.18em] font-semibold text-stone-500">
											{item.label}
										</div>
										<div class="col-span-7 text-sm font-sans text-stone-900 font-normal">
											{item.value}
										</div>
									</div>
								))
							}
						</div>
					</div>

					<!-- ACTION CTA BUTTON -->
					<div>
						<Button
							variant="primary"
							size="lg"
							fullWidth={true}
							icon="solar:bell-linear"
							iconPosition="left"
							class="notify-btn rounded-sm py-3.5 text-xs font-mono uppercase tracking-widest"
							data-product={product.title}
							data-product-slug={product.slug}
							data-product-series={product.series}
						>
							<span>AVISE-ME</span>
						</Button>

						<div class="flex items-center justify-between text-[11px] font-mono text-stone-500 pt-4">
							<span>✓ Garantia Vitalícia</span>
							<span>✓ Envio Seguro</span>
							<span>✓ Certificado Suíço</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 3. ARCHITECTURE & CRAFTSMANSHIP HIGHLIGHT -->
		<section class="max-w-[1440px] mx-auto px-6 md:px-24 pb-20 md:pb-28">
			<div
				class="p-8 md:p-12 border border-stone-300 bg-white/60 backdrop-blur-sm rounded-sm flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 text-left"
			>
				<div class="space-y-3 max-w-2xl">
					<div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-sm bg-stone-200/70 border border-stone-300/80 text-stone-600 text-xs font-mono">
						<span class="w-1.5 h-1.5 bg-stone-500 rounded-sm"></span>
						<span>Engenharia de Precisão</span>
					</div>
					<h2 class="font-display text-2xl md:text-3xl font-medium tracking-tight text-stone-900 leading-snug">
						Arquitetura em Titânio & Equilíbrio Neutro
					</h2>
					<p class="text-stone-600 text-sm md:text-base font-light leading-relaxed">
						Usinada a partir de uma barra sólida de Titânio Ti-6Al-4V (Grau 5) sob tolerâncias micrométricas. Centro de gravidade calibrado no ponto de apoio para eliminar a fadiga e proporcionar escrita contínua.
					</p>
				</div>
				<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 w-full lg:w-auto shrink-0 font-mono text-xs">
					<div class="border border-stone-300/80 bg-stone-50/80 p-4 rounded-sm text-left">
						<h3 class="text-[10px] text-stone-400 block uppercase tracking-wider mb-1 font-mono">Tolerância</h3>
						<span class="text-sm font-semibold text-stone-900 font-mono">± 0.005 mm</span>
					</div>
					<div class="border border-stone-300/80 bg-stone-50/80 p-4 rounded-sm text-left">
						<h3 class="text-[10px] text-stone-400 block uppercase tracking-wider mb-1 font-mono">Equilíbrio</h3>
						<span class="text-sm font-semibold text-stone-900 font-mono">50 / 50</span>
					</div>
					<div class="border border-stone-300/80 bg-stone-50/80 p-4 rounded-sm text-left col-span-2 sm:col-span-1">
						<h3 class="text-[10px] text-stone-400 block uppercase tracking-wider mb-1 font-mono">Garantia</h3>
						<span class="text-sm font-semibold text-stone-900 font-mono">Vitalícia</span>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. RELATED PRODUCTS SECTION -->
		<section class="bg-[#EAEAE5] py-24 md:py-32 border-t border-stone-300">
			<div class="max-w-[1440px] mx-auto px-6 md:px-24">
				<div class="mb-14 text-left flex flex-col items-start">
					<div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-sm bg-stone-200/60 border border-stone-300/80 text-stone-600 text-xs font-mono mb-4">
						<span class="w-1.5 h-1.5 bg-stone-500 rounded-sm"></span>
						<span>Coleção 2026</span>
					</div>
					<h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-normal tracking-tight text-stone-900 leading-[1.1]">
						Outros Instrumentos de Escrita
					</h2>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{
						relatedProducts.map((pen) => (
							<ProductCard
								id={pen.id}
								slug={pen.slug}
								title={pen.title}
								badgeLeft={pen.badgeLeft}
								badgeRight={pen.badgeRight}
								image={pen.image}
								description={pen.description}
								pena={pen.pena}
								material={pen.material}
								recarga={pen.recarga}
							/>
						))
					}
				</div>
			</div>
		</section>

		<!-- 5. NOTIFY ME MODAL -->
		<div
			id="notify-modal"
			style="display: none;"
			class="fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm px-4"
		>
			<div
				class="relative w-full max-w-md bg-white border border-stone-300 rounded-sm p-8 shadow-xl text-left"
				id="notify-modal-card"
			>
				<button
					id="close-modal"
					class="absolute top-5 right-5 text-stone-400 hover:text-stone-900 transition-colors p-1 cursor-pointer"
					aria-label="Fechar"
				>
					<Icon name="solar:close-circle-linear" class="text-2xl" />
				</button>

				<div class="w-10 h-10 bg-stone-100 rounded-sm flex items-center justify-center text-stone-900 mb-4">
					<Icon name="solar:bell-bold-duotone" class="text-xl" />
				</div>

				<h2 class="font-display text-2xl font-medium text-stone-900 mb-1" id="modal-product-title">
					AVISE-ME
				</h2>
				<p class="text-xs font-mono text-stone-500 uppercase tracking-wider mb-6">
					Notificação de Disponibilidade • Lote Exclusivo
				</p>

				<form id="notify-form" class="space-y-4">
					<div>
						<label for="notify-name" class="block text-xs font-mono uppercase tracking-wider text-stone-500 mb-2">
							Nome Completo
						</label>
						<input
							type="text"
							name="name"
							id="notify-name"
							required
							placeholder="Seu nome"
							class="w-full px-4 py-3 border border-stone-300 rounded-sm bg-stone-50 text-stone-900 text-sm focus:outline-none focus:border-stone-900 focus:bg-white transition-colors"
						/>
					</div>

					<div>
						<label for="notify-phone" class="block text-xs font-mono uppercase tracking-wider text-stone-500 mb-2">
							Telefone / WhatsApp
						</label>
						<input
							type="tel"
							name="phone"
							id="notify-phone"
							required
							placeholder="(11) 99999-9999"
							class="w-full px-4 py-3 border border-stone-300 rounded-sm bg-stone-50 text-stone-900 text-sm focus:outline-none focus:border-stone-900 focus:bg-white transition-colors"
						/>
					</div>

					<div>
						<label for="notify-email" class="block text-xs font-mono uppercase tracking-wider text-stone-500 mb-2">
							E-mail Principal
						</label>
						<input
							type="email"
							name="email"
							id="notify-email"
							required
							placeholder="seu@email.com"
							class="w-full px-4 py-3 border border-stone-300 rounded-sm bg-stone-50 text-stone-900 text-sm focus:outline-none focus:border-stone-900 focus:bg-white transition-colors"
						/>
					</div>

					<Button
						type="submit"
						variant="primary"
						size="lg"
						fullWidth={true}
						class="rounded-sm py-3.5 text-xs font-mono uppercase tracking-widest mt-2"
					>
						Confirmar Cadastro
					</Button>
				</form>

				<!-- Success State -->
				<div id="notify-success" class="hidden text-center py-6 space-y-3">
					<div class="w-12 h-12 bg-emerald-100 text-emerald-800 rounded-full flex items-center justify-center mx-auto text-xl">
						✓
					</div>
					<h3 class="font-display text-xl text-stone-900 font-medium">Cadastro Confirmado</h3>
					<p class="text-sm text-stone-600 font-light leading-relaxed">
						Você receberá um link prioritário via WhatsApp e e-mail minutos antes da abertura oficial do próximo lote.
					</p>
				</div>
			</div>
		</div>
	</div>

	<!-- Interactive Gallery & Modal Scripts -->
	<script>
		const initProductPage = () => {
			// 1. Gallery Image Switcher
			const mainImage = document.getElementById('main-product-image') as HTMLImageElement | null;
			const activeLabel = document.getElementById('active-image-label');
			const thumbButtons = document.querySelectorAll('.thumb-btn');

			thumbButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const newSrc = btn.getAttribute('data-img-src');
					const newLabel = btn.getAttribute('data-label');

					if (mainImage && newSrc) {
						mainImage.src = newSrc;
					}
					if (activeLabel && newLabel) {
						activeLabel.textContent = newLabel;
					}

					thumbButtons.forEach((b) => {
						b.classList.remove('border-stone-900', 'ring-2', 'ring-stone-900/10');
						b.classList.add('border-stone-300', 'opacity-60');
					});
					btn.classList.add('border-stone-900', 'ring-2', 'ring-stone-900/10');
					btn.classList.remove('opacity-60');
				});
			});

			// 2. Modal Logic
			const modal = document.getElementById('notify-modal');
			const modalCard = document.getElementById('notify-modal-card');
			const closeBtn = document.getElementById('close-modal');
			const modalTitle = document.getElementById('modal-product-title');
			const form = document.getElementById('notify-form') as HTMLFormElement | null;
			const success = document.getElementById('notify-success');
			const notifyButtons = document.querySelectorAll('.notify-btn');

			if (!modal || !modalCard || !closeBtn || !form || !success) return;

			const openModal = (productName: string) => {
				if (modalTitle) {
					modalTitle.textContent = productName ? `AVISE-ME • ${productName.toUpperCase()}` : 'AVISE-ME';
				}
				modal.style.display = 'flex';
				document.body.style.overflow = 'hidden';
			};

			const closeModal = () => {
				modal.style.display = 'none';
				document.body.style.overflow = '';
				setTimeout(() => {
					form.reset();
					form.classList.remove('hidden');
					success.classList.add('hidden');
				}, 200);
			};

			// Disparo de visualização de produto no Meta Pixel
			if (typeof (window as any).fbq === 'function') {
				(window as any).fbq('track', 'ViewContent', {
					content_name: document.title,
					content_type: 'product',
				});
			}

			notifyButtons.forEach((btn) => {
				btn.addEventListener('click', (e) => {
					e.preventDefault();
					const target = e.currentTarget as HTMLElement;
					const productName = target.getAttribute('data-product') || '';
					const productSlug = target.getAttribute('data-product-slug') || '';

					// 1. Envio para o Google Analytics 4 (gtag.js)
					if (typeof (window as any).gtag === 'function') {
						(window as any).gtag('event', 'click_avise_me', {
							event_category: 'Engajamento',
							event_label: productName,
							product_name: productName,
							product_slug: productSlug,
							page_location: window.location.href,
						});
					}

					// 2. Envio para o Google Tag Manager (dataLayer)
					(window as any).dataLayer = (window as any).dataLayer || [];
					(window as any).dataLayer.push({
						event: 'click_avise_me',
						product_name: productName,
						product_slug: productSlug,
						page_path: window.location.pathname,
					});

					// 3. Envio para o Meta Pixel (fbq)
					if (typeof (window as any).fbq === 'function') {
						(window as any).fbq('trackCustom', 'ClickAviseMe', {
							content_name: productName,
							content_ids: [productSlug],
						});
					}

					openModal(productName);
				});
			});

			closeBtn.addEventListener('click', closeModal);

			modal.addEventListener('click', (e) => {
				if (e.target === modal) closeModal();
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && modal.style.display === 'flex') {
					closeModal();
				}
			});

			form.addEventListener('submit', (e) => {
				e.preventDefault();
				const currentProduct = modalTitle?.textContent?.replace(/^AVISE-ME\s*•?\s*/, '') || '';
				const nameVal = (form.querySelector('input[name="name"]') as HTMLInputElement)?.value || '';
				const phoneVal = (form.querySelector('input[name="phone"]') as HTMLInputElement)?.value || '';
				const emailVal = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value || '';
				const eventId = `lead_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`;

				// Medição de Lead/Conversão no Google Analytics 4
				if (typeof (window as any).gtag === 'function') {
					(window as any).gtag('event', 'generate_lead', {
						event_category: 'Conversões',
						event_label: currentProduct,
						product_name: currentProduct,
						page_location: window.location.href,
					});
				}

				// Medição de Lead no Google Tag Manager
				(window as any).dataLayer = (window as any).dataLayer || [];
				(window as any).dataLayer.push({
					event: 'generate_lead',
					product_name: currentProduct,
					page_path: window.location.pathname,
				});

				// Medição de Lead no Meta Pixel (Navegador com ID de desduplicação)
				if (typeof (window as any).fbq === 'function') {
					(window as any).fbq('track', 'Lead', {
						content_name: currentProduct,
					}, { eventID: eventId });
				}

				// Medição de Lead na Meta Conversions API (Servidor)
				fetch('/api/lead', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						name: nameVal,
						phone: phoneVal,
						email: emailVal,
						productName: currentProduct,
						eventId: eventId,
					}),
				}).catch((err) => {
					console.warn('Falha no envio do Lead via servidor:', err);
				});

				form.classList.add('hidden');
				success.classList.remove('hidden');
				setTimeout(() => {
					closeModal();
				}, 3500);
			});
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initProductPage);
		} else {
			initProductPage();
		}
		document.addEventListener('astro:page-load', initProductPage);
	</script>
</Layout>
