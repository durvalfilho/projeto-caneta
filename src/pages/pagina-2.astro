---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Button from '../components/Button.astro';

const pens = [
	{
		id: '01',
		title: 'Titanium Stealth Minimalist',
		badgeLeft: 'EDIÇÃO LIMITADA',
		badgeRight: 'ESGOTADO',
		image: '/assets/pens/pen_raw_titanium.jpg',
		description:
			'Design ultra-leve de precisão usinado em titânio aeroespacial Grau 5 com equilíbrio de peso milimétrico.',
		pena: 'Ouro 18k Fine',
		material: 'Titânio G5',
		recarga: 'Tinteiro / Pistão',
	},
	{
		id: '02',
		title: 'Precision Ceramic White',
		badgeLeft: 'NOVO LANÇAMENTO',
		badgeRight: 'EM BREVE',
		image: '/assets/pens/pen_stealth_black.jpg',
		description:
			'Revestimento cerâmico de alta resistência com acabamento fosco aveludado e mecanismo retrátil hidráulico.',
		pena: 'Aço Inox M',
		material: 'Cerâmica Zircônia',
		recarga: 'Rollerball G2',
	},
	{
		id: '03',
		title: 'Obsidian Matte Black',
		badgeLeft: 'COLEÇÃO 2026',
		badgeRight: 'ESGOTADO',
		image: '/assets/pens/pen_champagne_gold.jpg',
		description:
			'Acabamento obsidian antirreflexo com gravura a laser e sistema de amortecimento tátil ao escrever.',
		pena: 'Carbon EF',
		material: 'Alumínio Anodizado',
		recarga: 'Esferográfica',
	},
	{
		id: '04',
		title: 'Precision Midnight Navy',
		badgeLeft: 'ATELIER SERIES',
		badgeRight: 'EM BREVE',
		image: '/assets/pens/pen_midnight_blue.jpg',
		description:
			'Pigmentação eletroquímica azul profunda com clip negro PVD e mecanismo de amortecimento silencioso.',
		pena: '0.3 mm Fine',
		material: 'Alumínio 6061',
		recarga: 'Rollerball G2',
	},
	{
		id: '05',
		title: 'Champagne Brass Heritage',
		badgeLeft: 'HERITAGE LINE',
		badgeRight: 'PRÉ-VENDA',
		image: '/assets/pens/pen_champagne_gold.jpg',
		description:
			'Corpo em liga nobre de latão náutico escovado manualmente com pátina que evolui ao longo do tempo.',
		pena: 'Ouro 14k M',
		material: 'Latão Escovado',
		recarga: 'Tinteiro / Conversor',
	},
	{
		id: '06',
		title: 'Forged Carbon Hypercraft',
		badgeLeft: 'HYPERCRAFT',
		badgeRight: 'ESGOTADO',
		image: '/assets/pens/pen_forged_carbon.jpg',
		description:
			'Fibras de carbono forjadas a alta pressão com conexões usinadas em titânio. Estrutura ultra-leve de 11.8g.',
		pena: 'Carbon 0.3mm',
		material: 'Carbono Forjado',
		recarga: 'Rollerball G2',
	},
	{
		id: '07',
		title: 'Space Silver Monobloc',
		badgeLeft: 'PRECISION SERIES',
		badgeRight: 'EM BREVE',
		image: '/assets/pens/pen_space_silver.jpg',
		description:
			'Acabamento prateado com polimento micro-esferado e sistema de tinta híbrida com regulação capilar.',
		pena: 'Aço Inox F',
		material: 'Alumínio 6061',
		recarga: 'Rollerball G2',
	},
	{
		id: '08',
		title: 'Gunmetal Dark Technical',
		badgeLeft: 'STUDIO EDITION',
		badgeRight: 'PRÉ-VENDA',
		image: '/assets/pens/pen_gunmetal_gray.jpg',
		description:
			'Tratamento em grafite escuro com micro-ranhuras lineares para traço milimétrico e estabilidade absoluta.',
		pena: '0.5 mm Medium',
		material: 'Alu Anodizado',
		recarga: 'Esferográfica',
	},
	{
		id: '09',
		title: 'Obsidian Copper Artisan',
		badgeLeft: 'EDIÇÃO LIMITADA',
		badgeRight: 'EM BREVE',
		image: '/assets/pens/pen_obsidian_copper.jpg',
		description:
			'Seção de pega em cobre de alta densidade combinada com chassi escurecido por deposição física de vapor (DLC).',
		pena: 'Tungstênio 0.3',
		material: 'Cobre + DLC',
		recarga: 'Rollerball G2',
	},
];
---

<Layout title="Catálogo de Canetas | ARTOOLS.PRO">
	<main class="min-h-screen bg-[#EAEAE5] pt-28 md:pt-36 pb-28 selection:bg-stone-900 selection:text-white">
		<div class="max-w-[1440px] mx-auto px-6 md:px-24">
			<!-- Header Section -->
			<div class="mb-14 md:mb-16 text-left flex flex-col items-start">
				<!-- Pill Badge -->
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-stone-200/60 border border-stone-300/80 text-stone-600 text-xs font-mono mb-6">
					<span class="w-1.5 h-1.5 bg-stone-500 rounded-full"></span>
					<span>Catálogo Exclusivo</span>
				</div>

				<!-- Title -->
				<h1
					class="font-display text-4xl sm:text-5xl md:text-6xl font-normal tracking-tight text-stone-900 mb-6 leading-[1.08] text-left"
				>
					Instrumentos de Escrita de<br />
					Precisão
				</h1>

				<!-- Subtitle -->
				<p class="text-stone-600 text-sm md:text-base font-light max-w-xl leading-relaxed text-left">
					Explore nossa coleção exclusiva de canetas de alta engenharia. Devido à altíssima
					demanda, selecione qualquer modelo e cadastre-se para ser notificado no próximo lote.
				</p>
			</div>

			<!-- Product Grid (3x3 on desktop) -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{
					pens.map((pen) => (
						<ProductCard
							id={pen.id}
							title={pen.title}
							badgeLeft={pen.badgeLeft}
							badgeRight={pen.badgeRight}
							image={pen.image}
							description={pen.description}
							pena={pen.pena}
							material={pen.material}
							recarga={pen.recarga}
						/>
					))
				}
			</div>

			<!-- Bottom Guarantee & Assistance Note -->
			<div
				class="mt-20 p-8 md:p-12 border border-stone-300 bg-white/70 backdrop-blur-sm rounded-none flex flex-col md:flex-row items-center justify-between gap-6"
			>
				<div class="space-y-1 text-center md:text-left">
					<h4 class="font-display text-xl font-medium text-stone-900">
						Garantia Vitalícia & Certificado Suíço
					</h4>
					<p class="text-sm text-stone-500 font-light max-w-xl">
						Todos os instrumentos acompanham número de série gravado a laser e garantia integral
						contra defeitos de fabricação.
					</p>
				</div>
				<div class="flex items-center gap-4 shrink-0">
					<Button href="/" variant="secondary" size="md" class="rounded-none">
						Voltar ao Início
					</Button>
				</div>
			</div>
		</div>

		<!-- Notify Me Interactive Modal -->
		<div
			id="notify-modal"
			class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 px-4"
		>
			<div
				class="relative w-full max-w-md bg-white border border-stone-300 rounded-none p-8 shadow-2xl scale-95 transition-transform duration-300 text-left"
				id="notify-modal-card"
			>
				<button
					id="close-modal"
					class="absolute top-5 right-5 text-stone-400 hover:text-stone-900 transition-colors p-1"
					aria-label="Fechar"
				>
					<iconify-icon icon="solar:close-circle-linear" class="text-2xl"></iconify-icon>
				</button>

				<div class="w-10 h-10 bg-stone-100 rounded-full flex items-center justify-center text-stone-900 mb-4">
					<iconify-icon icon="solar:bell-bold-duotone" class="text-xl"></iconify-icon>
				</div>

				<h3 class="font-display text-2xl font-medium text-stone-900 mb-1" id="modal-product-title">
					AVISE-ME
				</h3>
				<p class="text-xs font-mono text-stone-500 uppercase tracking-wider mb-6">
					Notificação de Disponibilidade
				</p>

				<form id="notify-form" class="space-y-4">
					<div>
						<label for="p2-notify-name" class="block text-xs font-mono uppercase tracking-wider text-stone-500 mb-2">
							Nome Completo
						</label>
						<input
							type="text"
							name="name"
							id="p2-notify-name"
							required
							placeholder="Seu nome"
							class="w-full px-4 py-3 border border-stone-300 rounded-none bg-stone-50 text-stone-900 text-sm focus:outline-none focus:border-stone-900 focus:bg-white transition-colors"
						/>
					</div>

					<div>
						<label for="p2-notify-phone" class="block text-xs font-mono uppercase tracking-wider text-stone-500 mb-2">
							Telefone / WhatsApp
						</label>
						<input
							type="tel"
							name="phone"
							id="p2-notify-phone"
							required
							placeholder="(00) 00000-0000"
							class="w-full px-4 py-3 border border-stone-300 rounded-none bg-stone-50 text-stone-900 text-sm focus:outline-none focus:border-stone-900 focus:bg-white transition-colors"
						/>
					</div>

					<div>
						<label for="p2-notify-email" class="block text-xs font-mono uppercase tracking-wider text-stone-500 mb-2">
							E-mail
						</label>
						<input
							type="email"
							name="email"
							id="p2-notify-email"
							required
							placeholder="seu@email.com"
							class="w-full px-4 py-3 border border-stone-300 rounded-none bg-stone-50 text-stone-900 text-sm focus:outline-none focus:border-stone-900 focus:bg-white transition-colors"
						/>
					</div>

					<Button type="submit" variant="primary" size="md" fullWidth={true} class="rounded-none">
						CONFIRMAR NOTIFICAÇÃO
					</Button>
				</form>

				<div id="modal-success" class="hidden mt-4 p-4 bg-stone-100 border border-stone-200 text-stone-800 text-xs font-mono text-center">
					✓ Você será avisado no instante em que este lote estiver liberado!
				</div>
			</div>
		</div>
	</main>

	<!-- Script for interactive modal behavior -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const modal = document.getElementById('notify-modal');
			const modalCard = document.getElementById('notify-modal-card');
			const modalTitle = document.getElementById('modal-product-title');
			const closeBtn = document.getElementById('close-modal');
			const form = document.getElementById('notify-form');
			const successMsg = document.getElementById('modal-success');
			const phoneInput = document.getElementById('p2-notify-phone');

			if (phoneInput) {
				phoneInput.addEventListener('input', (e) => {
					let v = e.target.value.replace(/\D/g, '');
					if (v.length > 11) v = v.slice(0, 11);
					if (v.length > 10) {
						v = v.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
					} else if (v.length > 6) {
						v = v.replace(/^(\d{2})(\d{4})(\d{0,4})$/, '($1) $2-$3');
					} else if (v.length > 2) {
						v = v.replace(/^(\d{2})(\d{0,5})$/, '($1) $2');
					} else if (v.length > 0) {
						v = v.replace(/^(\d*)$/, '($1');
					}
					e.target.value = v;
				});
			}

			const openModal = (productName) => {
				if (!modal) return;
				modalTitle.textContent = productName || 'AVISE-ME';
				successMsg.classList.add('hidden');
				form.reset();
				form.classList.remove('hidden');
				modal.classList.remove('opacity-0', 'pointer-events-none');
				modalCard.classList.remove('scale-95');
				modalCard.classList.add('scale-100');
			};

			const closeModal = () => {
				if (!modal) return;
				modal.classList.add('opacity-0', 'pointer-events-none');
				modalCard.classList.add('scale-95');
				modalCard.classList.remove('scale-100');
			};

			document.querySelectorAll('.notify-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const product = btn.getAttribute('data-product');
					openModal(product);
				});
			});

			if (closeBtn) closeBtn.addEventListener('click', closeModal);

			if (modal) {
				modal.addEventListener('click', (e) => {
					if (e.target === modal) closeModal();
				});
			}

			if (form) {
				form.addEventListener('submit', (e) => {
					e.preventDefault();
					form.classList.add('hidden');
					successMsg.classList.remove('hidden');
					setTimeout(() => {
						closeModal();
					}, 2500);
				});
			}
		});
	</script>
</Layout>
